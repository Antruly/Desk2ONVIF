# --- pre-existing unrelated data ---
# This directory is used as a scratch/temp area by other tooling on this machine
# (it held ~6 GB of VS installer + unrelated app temp before this project existed).
# It is NOT part of the project. Never commit it, never delete it from here.
/Temp/

# --- build output ---
/build*/
/out/
/cmake-build-*/
# 交付物（安装包 69 MB + 绿色版 zip 99 MB）。它们完全由源码 + scripts\package.ps1
# 生成，而 git 的历史是**只增不减**的：一旦提交进去，日后把这行加回来也删不掉，
# 仓库从此永久多背 170 MB（而且每改一次就要再存一份）。
/release/

# 在源码目录里手滑跑过一次 cmake 留下的东西（就是陷阱 18 那次）。
# 空目录 git 本来就不跟踪，写在这里是为了让 `git status` 干净 ——
# 否则下一次真的在源码目录里配了 CMake，几百个文件会直接混进待提交列表。
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake

# --- provisioned dependencies (generated by scripts/, see third_party/README.md) ---
# 用 /third_party/* 而不是 /third_party/：目录本身不能进排除列表，否则下面
# 那条 ! 不生效 —— git 的规则是"父目录被排除时，无法再把里面的文件加回来"。
/third_party/*
!/third_party/README.md

# --- Vue frontend ---
# node_modules 不带前导斜杠，任意一层都盖住：本项目有**两份**
# （web/ 64 MB、tests/browser/ 14 MB）。原先只写了 /web/node_modules/，
# 而 tests/browser/ 那一份没被覆盖 —— 它偏偏在 tests/ 底下，正是
# "顺手把整个 tests/ 加进去"最容易带进仓库的那种位置。
# 依赖树由 package-lock.json 固定，那个文件**要**提交。
node_modules/
/web/dist/
/web/.vite/

# --- editor / OS ---
.vs/
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# --- Python 探针的字节码缓存 ---
# tests\ 下跑一次探针就会生成，而 .pyc 里带着**生成它的解释器版本**
# （这里是 cpython-314），换台机器就是一堆无效且会冲突的二进制。
# 它还会让 `git status` 永远显示"有改动"，掩盖真正的改动。
__pycache__/
*.pyc

# --- local runtime artifacts ---
*.log
/recordings/
/config.local.json
