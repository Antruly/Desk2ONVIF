/* Desk2ONVIF 的 Windows 资源脚本。
 *
 * 为什么需要它 —— 图标在这个项目里有**三处**，各管各的，少一处就有一处
 * 显示成 Windows 的默认图标，而三处的表现完全不同：
 *   1. exe 自己（资源管理器里看文件、任务栏、Alt-Tab、拖到别处）—— 就是这里；
 *   2. 安装包 Setup.exe（Inno 的 SetupIconFile，见 packaging/desk2onvif.iss）；
 *   3. 快捷方式（Inno 的 [Icons] IconFilename）。
 * 只做 2、3 的话，安装包好看、快捷方式好看，而程序一跑起来任务栏上是个
 * 白底默认图标 —— 因为任务栏认的是进程的 exe，谁都不看安装包。
 *
 * 这个文件是**纯 ASCII 之外只有注释里有中文**，记得用 UTF-8 存，
 * 并且别加 BOM：windres 对 BOM 的处理很差，会在文件开头报语法错。
 * 版本块里的中文靠 CMake 传的 --codepage=65001 转成 UTF-16，
 * 验证方式是编完读一遍 exe 的 VersionInfo（scripts\verify_installer.ps1 里有一条）。
 */

/* 这个 include 不是装饰：VOS_NT_WINDOWS32 / VFT_APP 这些名字都定义在
   头文件里，不包含的话它们在 rc 语法里就是未定义的标识符，报的是
   "syntax error" 指向 FILEOS 那一行 —— 看着像语法写错了，其实是缺 include。
   （windres 会以 `gcc -E -xc -DRC_INVOKED` 先跑一遍预处理器，
   所以这里走的是 MinGW 的 windows.h。） */
#include <windows.h>

1 ICON "desk2onvif.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    /* 0x0804 = 中文(简体)，0x04b0 = 1200 = Unicode。两处必须和下面
       VarFileInfo 里的 Translation 对上，否则读的人会按别的代码页解。 */
    BLOCK "080404b0"
    BEGIN
      VALUE "CompanyName",      "Desk2ONVIF contributors"
      VALUE "FileDescription",  "Desk2ONVIF — 把桌面变成 ONVIF 摄像机"
      VALUE "FileVersion",      "0.1.0"
      VALUE "InternalName",     "desk2onvif"
      VALUE "LegalCopyright",   "GPL-3.0-or-later"
      VALUE "OriginalFilename", "desk2onvif.exe"
      VALUE "ProductName",      "Desk2ONVIF"
      VALUE "ProductVersion",   "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x804, 1200
  END
END
